{
  "version": 1,
  "indentation": { "spaces": 4 },
  "lineLength": 120,
  "maximumBlankLines": 1,
  "respectsExistingLineBreaks": true,
  "multiElementCollectionTrailingCommas": false,
  "rules": {
    "AlwaysUseLowerCamelCase": true,
    "NoAccessLevelOnExtensionDeclaration": true,
    "OrderedImports": true,
    "UseEarlyExits": false
  }
}
